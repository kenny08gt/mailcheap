[Unit]
Description=Mailcheap list hygiene: stop contacts on domains that can't receive email
After=mailcheap.service

[Service]
Type=oneshot
EnvironmentFile=/etc/mailcheap/mailcheap.env
ExecStart=/bin/sh -c 'curl -fsS -m 290 -X POST -H "Authorization: Bearer $CRON_SECRET" http://127.0.0.1:3000/api/jobs/list-hygiene'
